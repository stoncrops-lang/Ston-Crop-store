# ==============================================================================
# STONCROPS ENVIRONMENT CONFIGURATION
# Copy this file to .env.local in apps/storefront and apps/admin
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Required for Database, Auth & Storage)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT APPS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Storage Bucket for Product Images
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY (Required for UPI & Netbanking Payments)
# ------------------------------------------------------------------------------
# Key ID from Razorpay Dashboard -> Settings -> API Keys (Test mode begins with rzp_test_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Settings -> Webhooks -> Add New Webhook -> Secret)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 3. WHATSAPP BUSINESS CLOUD API (Required for Real-time Owner Alerts)
# ------------------------------------------------------------------------------
# Meta for Developers -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Phone number of the store owner to receive incoming order alerts (with country code, e.g. 919876543210)
OWNER_WHATSAPP_NUMBER=919876543210

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="STONCROPS <orders@stoncrops.com>"
OWNER_EMAIL=founder@stoncrops.com

# ------------------------------------------------------------------------------
# 5. DOMAIN & APP URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_URL=https://stoncrops.com
NEXT_PUBLIC_ADMIN_URL=https://admin.stoncrops.com

# Node Environment
NODE_ENV=development
